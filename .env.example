# ToyBox — frontend environment template.
# Copy to `.env.local` for development overrides. Vite only exposes
# variables prefixed with VITE_ (they are baked into the bundle at build
# time — never put secrets here).

# Base URL of the ToyBox REST API.
#   dev:            http://localhost:4000/api  (default)
#   same-origin:    /api                       (nginx/proxy forwards to the API)
#   split origin:   https://api.example.com/api
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: replace the console-only client error reporter with a real
# provider adapter wired in src/lib/errorTracking.ts (see docs/deployment.md).
# VITE_ERROR_REPORT_URL=
