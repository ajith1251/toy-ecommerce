# ToyBox API — development environment template.
# Copy to `server/.env` (git-ignored) and fill in real values.
# Every variable below is optional in development: the server boots with
# sane defaults (embedded PostgreSQL, console email, no payment provider).
# Production requirements are documented in ../.env.production.example.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# pretty = human-readable dev logs; json = machine-parseable JSON lines
LOG_FORMAT=pretty

# ── Database ───────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the embedded PostgreSQL 18 instance that
# the server manages itself (data dir: server/.pgdata). Set it to target an
# external database instead.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
EMBEDDED_PG=1
EMBEDDED_PG_PORT=55432
DB_NAME=toybox
EMBEDDED_PG_USER=toybox
EMBEDDED_PG_PASSWORD=toybox
EMBEDDED_PG_DATA_DIR=.pgdata

# Connection pool sizing (per API process)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# ── Security ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (dev defaults cover Vite).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SESSION_TTL_MS=604800000
SESSION_COOKIE_NAME=toybox_session
PASSWORD_RESET_TTL_MS=1800000

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=100

# ── Payments — Razorpay ────────────────────────────────────────────────────
# Test-mode keys (rzp_test_…) from the Razorpay dashboard enable Standard
# Checkout against Razorpay's sandbox. Leave blank to run without the
# payment provider (COD still works; card/UPI routes are not registered).
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret
# Webhook secret configured in the Razorpay dashboard for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_TIMEOUT_MS=15000

# ── Email (password-reset delivery) ────────────────────────────────────────
# console = log reset links (default dev), file = JSONL outbox (E2E),
# smtp = real email via nodemailer.
EMAIL_TRANSPORT=console
MAIL_FROM=ToyBox <no-reply@toybox.local>
APP_BASE_URL=http://localhost:5173
EMAIL_OUTBOX_PATH=.outbox.jsonl
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change_me
# SMTP_SECURE=0
