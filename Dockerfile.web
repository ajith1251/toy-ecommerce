# ── Stage 1: build the frontend production bundle ─────────────────────────
# Pinned major versions; node:22 matches CI and local development.
FROM node:22-alpine AS build
WORKDIR /app

# Install workspace dependencies first (lockfile respected for reproducibility)
COPY package.json package-lock.json ./
COPY server/package.json server/
RUN npm ci

# Build the static bundle. VITE_API_BASE_URL is a build-time constant:
# pass --build-arg VITE_API_BASE_URL=/api for same-origin deployments (the
# nginx container proxies /api to the backend) or an absolute URL when the
# API lives on another origin.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src
RUN npm run build

# ── Stage 2: serve the bundle with nginx ──────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# SPA routing + /api reverse proxy + cache headers (see file for details).
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
