# ToyBox API — PRODUCTION environment template.
# Copy to the deployment platform's secret store (never commit filled copies).
# The server refuses to boot in production if required values are missing
# (see validateProductionConfig in server/src/config.ts).

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# json = machine-parseable JSON lines; pretty = human-readable (dev)
LOG_FORMAT=json

# ── Database (REQUIRED) ────────────────────────────────────────────────────
# External PostgreSQL only — the embedded dev database must not be used.
DATABASE_URL=postgres://toybox_app:CHANGE_ME@db.internal:5432/toybox
EMBEDDED_PG=0
# Connection pool sizing (per API process)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# ── Security ───────────────────────────────────────────────────────────────
# Explicit comma-separated list of allowed browser origins. localhost is
# rejected in production.
CORS_ORIGINS=https://shop.example.com
# Cookies are Secure in production by default; overriding to 0 fails startup.
SESSION_COOKIE_SECURE=1
SESSION_TTL_MS=604800000
SESSION_COOKIE_NAME=toybox_session

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=100

# ── Payments — Razorpay (REQUIRED for production startup) ─────────────────
# Use live keys only after Razorpay account activation + KYC. Test keys
# (rzp_test_…) are valid for staging.
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Webhook secret configured in the Razorpay dashboard → the /api/payments/webhook URL
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_TIMEOUT_MS=15000

# ── Email (REQUIRED: SMTP so password resets are deliverable) ─────────────
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME
SMTP_SECURE=0
MAIL_FROM=ToyBox <no-reply@example.com>
APP_BASE_URL=https://shop.example.com
